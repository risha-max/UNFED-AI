#
# UNFED public testnet launch profile
# Safe defaults only; add chain secrets in a local override if needed.
#

# --- Web/API hardening ---
UNFED_DEV_AUTH_BYPASS=0
UNFED_ALLOW_DEMO_AUTH=0
UNFED_FAUCET_ENABLED=0
UNFED_FAUCET_REQUIRE_AUTH=1

# --- Node/daemon security defaults ---
UNFED_STRICT_SHARE_AUTH=1
UNFED_SHARE_TIP_ANCHOR_MODE=strict
UNFED_ALLOW_INSECURE_PUBLIC=0
UNFED_REQUIRE_MPC=0

# --- Public endpoint caching ---
UNFED_REGISTRY_SUMMARY_CACHE_TTL=2
UNFED_NETWORK_NODES_CACHE_TTL=2

# --- Launch defaults consumed by scripts/run_public_testnet_checklist.sh ---
WEB_HOST=0.0.0.0
WEB_PORT=8080
WEB_URL=http://127.0.0.1:8080
NODE_ADVERTISE_ADDR=
NODE_TLS_CERT=
NODE_TLS_KEY=

# --- Launch defaults consumed by scripts/start_public_testnet.sh ---
RUNTIME_DIR=.runtime/public-testnet
REGISTRY_HOST=127.0.0.1
REGISTRY_PORT=50050
REGISTRY_CLUSTER_CONFIG=cluster_config.json
REGISTRY_NO_CHAIN=1
DAEMON_HOST=127.0.0.1
DAEMON_PORT=50070
DAEMON_ADVERTISE_ADDR=
DAEMON_ETH_ADDRESS=
DAEMON_DB=.runtime/public-testnet/daemon-chain.db
NODE_ENABLED=0
NODE_HOST=127.0.0.1
NODE_PORT=50051
NODE_SHARD_INDEX=0
NODE_SHARDS_DIR=shards
NODE_ETH_ADDRESS=
NODE_WILLING_TO_MPC=1
MOCK_NODE_ENABLED=1
MOCK_NODE_MODEL_ID=mock/testnet-model
MOCK_NODE_ADDRESS=mock-node:59999
