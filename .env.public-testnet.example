#
# UNFED public testnet profile (copy to .env.public-testnet and edit secrets/hosts)
#

# --- Web/API hardening ---
UNFED_DEV_AUTH_BYPASS=0
UNFED_ALLOW_DEMO_AUTH=0
UNFED_FAUCET_ENABLED=0
UNFED_FAUCET_REQUIRE_AUTH=1
UNFED_FAUCET_STATE_DB=~/.unfed/faucet_state.db

# --- Node/daemon security defaults ---
UNFED_STRICT_SHARE_AUTH=1
UNFED_SHARE_TIP_ANCHOR_MODE=strict
UNFED_ALLOW_INSECURE_PUBLIC=0
# UNFED_REQUIRE_MPC=1

# --- Public endpoint behavior ---
UNFED_REGISTRY_SUMMARY_CACHE_TTL=2
UNFED_NETWORK_NODES_CACHE_TTL=2

# --- Escrow / settlement wiring (example placeholders) ---
# UNFED_ESCROW_ENABLED=1
# UNFED_ESCROW_RPC_URL=https://your-rpc-endpoint
# UNFED_ESCROW_CONTRACT_ADDRESS=0xYourEscrowContract
# UNFED_ESCROW_CHAIN_ID=84532

# --- Typical runtime args (reference only) ---
# WEB_HOST=0.0.0.0
# WEB_PORT=8080
# REGISTRY_ADDR=127.0.0.1:50050
# NODE_ADVERTISE_ADDR=your-public-hostname:50070

# --- Optional launcher defaults (scripts/start_public_testnet.sh) ---
# RUNTIME_DIR=.runtime/public-testnet
# REGISTRY_HOST=127.0.0.1
# REGISTRY_PORT=50050
# REGISTRY_CLUSTER_CONFIG=cluster_config.json
# REGISTRY_NO_CHAIN=0
# DAEMON_HOST=127.0.0.1
# DAEMON_PORT=50070
# DAEMON_ADVERTISE_ADDR=your-public-daemon-host:50070
# DAEMON_ETH_ADDRESS=0xYourDaemonStakedAddress
# DAEMON_DB=.runtime/public-testnet/daemon-chain.db
# NODE_ENABLED=1
# NODE_HOST=127.0.0.1
# NODE_PORT=50051
# NODE_ADVERTISE_ADDR=your-public-node-host:50051
# NODE_SHARD_INDEX=0
# NODE_SHARDS_DIR=shards
# NODE_ETH_ADDRESS=0xYourNodeStakedAddress
# NODE_WILLING_TO_MPC=1
# MOCK_NODE_ENABLED=0
# MOCK_NODE_MODEL_ID=mock/testnet-model
# MOCK_NODE_ADDRESS=mock-node:59999
